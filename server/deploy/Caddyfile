# /etc/caddy/Caddyfile
# Caddy obtains and renews TLS certificates automatically.
ats.example.com {
    encode gzip

    # OAuth 2.1 needs these to be publicly reachable, unauthenticated:
    #   /.well-known/oauth-authorization-server  discovery (RFC 8414)
    #   /.well-known/oauth-protected-resource    discovery (RFC 9728)
    #   /register    dynamic client registration (RFC 7591) — claude.ai self-registers
    #   /authorize   redirects the browser to the login page
    #   /token       code and refresh-token exchange
    #   /revoke      token revocation
    #   /oauth/*     the login page itself
    # Omit any of these and the connector fails partway through the handshake.
    @oauth path /.well-known/* /authorize /token /register /revoke /oauth/*
    handle @oauth {
        reverse_proxy 127.0.0.1:8080
    }

    # The MCP endpoint, and the upload page beneath it.
    handle /mcp* {
        # Enough for a 12 MB document as multipart or base64, and no more.
        request_body {
            max_size 20MB
        }
        reverse_proxy 127.0.0.1:8080 {
            # Streamable HTTP can hold a response open; do not cut it short.
            flush_interval -1
            transport http {
                read_timeout 300s
                write_timeout 300s
            }
        }
    }

    handle {
        respond "Not found" 404
    }

    # With OAuth on, the path is not a secret and can be logged normally.
    # Running WITHOUT OAuth (secret-path mode) means the URI *is* the
    # credential — uncomment the filter below so it never reaches the log.
    log {
        output file /var/log/caddy/ats-mcp.log
        # format filter {
        #     request>uri query { replace REDACTED }
        # }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
}
