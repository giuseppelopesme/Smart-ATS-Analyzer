# /etc/systemd/system/ats-mcp.service
[Unit]
Description=ATS CV validator MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atsmcp
Group=atsmcp
WorkingDirectory=/opt/ats-mcp
Environment=MCP_TRANSPORT=http
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=8080
Environment=ATS_OAUTH_STATE=/var/lib/ats-mcp/oauth.json
# Holds MCP_PUBLIC_URL, ATS_OAUTH_PASSWORD_HASH and (OAuth off only) MCP_PATH.
# See README.md.
EnvironmentFile=/etc/ats-mcp.env
ExecStart=/opt/ats-mcp/.venv/bin/python /opt/ats-mcp/server/ats_mcp.py
Restart=on-failure
RestartSec=5

# The service handles other people's CVs. Give it as little as possible.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Creates and owns /var/lib/ats-mcp, mode 0700 -- the only writable path.
# It holds registered OAuth clients and refresh tokens, never any document.
StateDirectory=ats-mcp
StateDirectoryMode=0700
MemoryMax=1G
TasksMax=64

[Install]
WantedBy=multi-user.target
